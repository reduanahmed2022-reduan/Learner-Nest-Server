# ---------------------------------------------------------------------------
# LearnNest server configuration. Copy to .env and fill in real values.
# Never commit real secrets to source control.
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas SRV URI or local mongodb:// URI)
MONGODB_URI=your_mongodb_atlas_connection_string

# JWT authentication (used by /api/auth/*)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# BetterAuth (mounted at /api/better-auth)
BETTER_AUTH_SECRET=replace_with_a_long_random_better_auth_secret
BETTER_AUTH_URL=http://localhost:5000

# Browser client origin(s). Comma separated for multiple deployments.
CLIENT_URL=http://localhost:3000

# Stripe subscriptions
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Image hosting
IMGBB_API_KEY=replace_with_imgbb_api_key
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_UPLOAD_PRESET=replace-with-unsigned-upload-preset
# Folder created automatically on the first upload (one per website).
CLOUDINARY_FOLDER=learnnest
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

# Seeded administrator (used by `npm run seed`)
ADMIN_EMAIL=admin@learnnest.app
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=LearnNest Admin
