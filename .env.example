NODE_ENV=development

# Database (MongoDB Atlas SRV URI or local mongodb:// URI)
MONGODB_URI=mongodb://LearnNest:WlUd4aOcdlM3Dqf9@ac-olcnc37-shard-00-00.vwbcbw0.mongodb.net:27017,ac-olcnc37-shard-00-01.vwbcbw0.mongodb.net:27017,ac-olcnc37-shard-00-02.vwbcbw0.mongodb.net:27017/?ssl=true&replicaSet=atlas-76l2a7-shard-0&authSource=admin
